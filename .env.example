# Copy to `.env` and fill in. Never commit `.env`.
OPENVPN_USER=
OPENVPN_PASSWORD=
# Optional overrides (defaults shown):
# VPN_PROVIDER=pia
# VPN_REGIONS=
# PUID=1000
# PGID=1000
# TZ=America/Los_Angeles
# DUET_ADDR=127.0.0.1
# DOWNLOADS_DIR=./downloads
# BROWSER_INBOX_DIR=./browser-inbox
# BROWSER_PROFILE_DIR=./browser-profile
# Start page for the remote Firefox (mirrors rotate — keep it matching
# duet's Settings → Anna's Archive mirror).
# AA_START_URL=https://annas-archive.gl
